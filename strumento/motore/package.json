{
  "name": "@esposizione/motore",
  "version": "3.0.0-alpha.2",
  "description": "ESPOSIZIONE Studio, il motore 3.0: formato dati, regole, controlli, librogame, app e simulazione. Per giocare non serve niente; esbuild e TypeScript servono soltanto a costruire l'app e a controllare i tipi.",
  "type": "module",
  "license": "CC-BY-SA-4.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "esposizione": "./src/cli.ts"
  },
  "scripts": {
    "test": "node --test",
    "gioca": "node src/cli.ts gioca",
    "controlla": "node src/cli.ts controlla",
    "libro": "node src/cli.ts libro",
    "simula": "node src/cli.ts simula",
    "app": "node web/costruisci.mjs",
    "tipi": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "typescript": "5.8.3"
  }
}
